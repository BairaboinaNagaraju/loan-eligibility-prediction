// SQLite-compliant schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                String           @id @default(uuid())
  email             String           @unique
  password          String
  fullName          String
  phone             String?          @unique
  role              String           @default("CUSTOMER") // CUSTOMER | LOAN_OFFICER | ADMIN
  avatar            String?
  isEmailVerified   Boolean          @default(false)
  isPhoneVerified   Boolean          @default(false)
  kycStatus         String           @default("PENDING") // PENDING | SUBMITTED | VERIFIED | REJECTED
  isActive          Boolean          @default(true)
  lastLogin         DateTime?
  emailVerifyToken  String?
  phoneOTP          String?
  phoneOTPExpiry    DateTime?
  passwordResetToken String?
  passwordResetExpiry DateTime?
  refreshToken      String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Relations
  kyc               KYCData?
  applications      LoanApplication[]
  notifications     Notification[]
  auditLogs         AuditLog[]

  @@map("users")
}

model KYCData {
  id          String    @id @default(uuid())
  userId      String    @unique
  aadhaar     String?   // Encrypted
  pan         String?   // Encrypted
  dob         DateTime?
  gender      String?
  address     String?
  city        String?
  state       String?
  pincode     String?
  country     String    @default("India")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("kyc_data")
}

model LoanApplication {
  id          String            @id @default(uuid())
  userId      String
  status      String            @default("SUBMITTED") // DRAFT | SUBMITTED | UNDER_REVIEW | APPROVED | REJECTED | CANCELLED
  ipAddress   String?

  // Personal Information
  fullName    String
  age         Int
  gender      String
  maritalStatus String
  dependents  Int               @default(0)

  // Employment Information
  employmentType String
  companyName String?
  jobExperience Float            // years
  monthlySalary Float
  annualIncome  Float

  // Financial Information
  existingLoans   Float           @default(0)
  creditScore     Int
  creditCardDebt  Float           @default(0)
  monthlyExpenses Float
  savings         Float           @default(0)
  investments     Float           @default(0)
  assets          Float           @default(0)

  // Loan Details
  loanAmount    Float
  loanPurpose   String
  loanTerm      Int               // months
  interestPref  String            @default("fixed")

  // AI Results (cached from ML service)
  aiVerdict     String?           // APPROVED | REJECTED
  aiConfidence  Float?
  riskScore     Float?
  riskLevel     String?
  fraudScore    Float?
  fraudFlags    String?           // JSON stringified
  explanation   String?           // JSON stringified
  aiSummary     String?
  improvements  String?           // JSON stringified

  submittedAt DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  reviewedAt  DateTime?
  reviewedBy  String?

  // Relations
  user          User              @relation(fields: [userId], references: [id])
  documents     Document[]
  prediction    Prediction?
  notifications Notification[]

  @@map("loan_applications")
}

model Prediction {
  id            String   @id @default(uuid())
  applicationId String   @unique
  verdict       String   // APPROVED | REJECTED
  confidence    Float
  riskScore     Float
  riskLevel     String
  fraudScore    Float
  fraudFlags    String?  // JSON stringified
  positiveFactors String? // JSON stringified
  negativeFactors String? // JSON stringified
  shapValues    String?  // JSON stringified
  modelUsed     String?
  modelVersion  String?
  processingMs  Int?
  aiSummary     String?
  improvements  String?  // JSON stringified
  createdAt     DateTime @default(now())

  application   LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("predictions")
}

model Document {
  id            String       @id @default(uuid())
  applicationId String
  userId        String
  type          String       // AADHAAR | PAN | SALARY_SLIP | BANK_STATEMENT | PASSPORT_PHOTO | OTHER
  originalName  String
  storedName    String
  path          String
  mimeType      String
  size          Int
  ocrData       String?      // JSON stringified
  isVerified    Boolean      @default(false)
  uploadedAt    DateTime     @default(now())

  application   LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model Notification {
  id            String           @id @default(uuid())
  userId        String
  applicationId String?
  type          String           // APPLICATION_SUBMITTED | APPLICATION_APPROVED | APPLICATION_REJECTED | DOCUMENT_REQUIRED | ADMIN_MESSAGE | SYSTEM
  title         String
  body          String
  isRead        Boolean          @default(false)
  metadata      String?          // JSON stringified
  createdAt     DateTime         @default(now())

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  application   LoanApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  resource    String
  resourceId  String?
  details     String?  // JSON stringified
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model ModelMetrics {
  id          String   @id @default(uuid())
  modelName   String
  accuracy    Float
  precision   Float
  recall      Float
  f1Score     Float
  rocAuc      Float
  isBest      Boolean  @default(false)
  trainedAt   DateTime @default(now())
  featureImportance String? // JSON stringified

  @@map("model_metrics")
}
