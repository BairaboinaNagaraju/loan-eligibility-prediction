# ========================
# DATABASE
# ========================
DATABASE_URL="postgresql://loanuser:loanpassword@localhost:5432/loandb"
POSTGRES_USER=loanuser
POSTGRES_PASSWORD=loanpassword
POSTGRES_DB=loandb

# ========================
# AUTH
# ========================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ========================
# SERVER
# ========================
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ========================
# ML SERVICE
# ========================
ML_SERVICE_URL=http://localhost:8001

# ========================
# EMAIL (Nodemailer)
# ========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Vertex Loan AI <noreply@vertexloan.com>"

# ========================
# FILE UPLOADS
# ========================
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# ========================
# ENCRYPTION
# ========================
ENCRYPTION_KEY=your-32-char-encryption-key-here!!

# ========================
# REDIS
# ========================
REDIS_URL=redis://localhost:6379

# ========================
# RATE LIMITING
# ========================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
